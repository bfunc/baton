{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {"type": "command", "bash": "bash '{{BATON}}/hooks/brief.sh' --json", "powershell": "& '{{BASH}}' '{{BATON}}/hooks/brief.sh' --json", "timeoutSec": 30}
    ],
    "PreToolUse": [
      {"type": "command", "bash": "bash '{{BATON}}/hooks/log-append-only.sh'", "powershell": "& '{{BASH}}' '{{BATON}}/hooks/log-append-only.sh'", "timeoutSec": 10}
    ],
    "Stop": [
      {"type": "command", "bash": "bash '{{BATON}}/hooks/stop-guard.sh'", "powershell": "& '{{BASH}}' '{{BATON}}/hooks/stop-guard.sh'", "timeoutSec": 15}
    ]
  }
}
